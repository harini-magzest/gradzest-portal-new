# Copy this file to .env and fill in all values before starting the server

# ── Required ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/gradzest
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
PORT=5000

# ── Email via Brevo SMTP relay (notifications, password reset, welcome emails) ─
# Brevo dashboard → Settings → SMTP & API → SMTP tab: copy the login and generate an SMTP key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=xxxxxxx@smtp-brevo.com
SMTP_PASS=<brevo-smtp-key>
# Sender shown on outgoing mail. Must be a verified sender/domain in Brevo (Senders, Domains & Dedicated IPs).
SMTP_FROM=info@magzest.in

# ── Frontend URL (required in production for CORS + password reset links) ─
FRONTEND_URL=https://yourdomain.com

# ── Zest AI assistant (knowledge-base Q&A + daily lead alerts) ─
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Fast + cheap, good enough for short retrieval-grounded answers
ZEST_MODEL=claude-haiku-4-5-20251001
# A lead counts as "stale" once this many days pass with no lead-stage movement
ZEST_STALE_DAYS=5

# ── Tata Smartflo (optional — counselor call stats on Admin → Counselors → Stats) ─
# API token from the Smartflo portal; sent as-is in the Authorization header
SMARTFLO_API_TOKEN=
# SMARTFLO_API_BASE=https://api-smartflo.tatateleservices.com/v1
# SMARTFLO_UTC_OFFSET=+05:30

# 64 hex chars (openssl rand -hex 32). Encrypts SOC data at rest. Losing it makes that data unreadable.
DATA_ENCRYPTION_KEY=
# Comma-separated emails allowed to open the SOC
SOC_OWNER_EMAILS=hameed@magzest.in

# Out-of-band SOC alerts to the owner (all optional). Messages are minimal by default: severity, type, time, link.
# SOC_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...   # Slack / Teams / Discord incoming webhook (https only)
# SOC_ALERT_WEBHOOK_FORMAT=slack                               # slack | teams | discord
# SOC_TELEGRAM_BOT_TOKEN=
# SOC_TELEGRAM_CHAT_ID=
# SOC_WEBHOOK_MIN_SEVERITY=high                               # info | low | medium | high | critical
# SOC_ALERT_DETAIL=minimal                                    # "full" adds the incident title (it passes through third parties)
