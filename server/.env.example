# Copy this file to .env and fill in all values before starting the server

# ── Required ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/gradzest
# At least 32 random characters. Production refuses to start with a short or placeholder value.
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
# Signs the five-minute links the app uses to open uploaded files. Same rules as JWT_SECRET, and it must be a different
# value. Required in production; left unset on a development machine, one is derived from JWT_SECRET.
FILE_URL_SECRET=<generate with the same command as JWT_SECRET>
PORT=5000

# ── Email via Brevo SMTP relay (notifications, password reset, welcome emails) ─
# Brevo dashboard → Settings → SMTP & API → SMTP tab: copy the login and generate an SMTP key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=xxxxxxx@smtp-brevo.com
SMTP_PASS=<brevo-smtp-key>
# Sender shown on outgoing mail. Must be a verified sender/domain in Brevo (Senders, Domains & Dedicated IPs).
SMTP_FROM=info@magzest.in

# ── Frontend URL (required in production for CORS + password reset links) ─
FRONTEND_URL=https://yourdomain.com

# ── Zest AI assistant (knowledge-base Q&A + daily lead alerts) ─
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Fast + cheap, good enough for short retrieval-grounded answers
ZEST_MODEL=claude-haiku-4-5-20251001
# A lead counts as "stale" once this many days pass with no lead-stage movement
ZEST_STALE_DAYS=5
# Optional free-tier fallback for local testing, used only when ANTHROPIC_API_KEY is unset (aistudio.google.com → API keys)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest              # default shown
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest # used when the main model stays overloaded after retries
# ZEST_THINKING=            # how much Gemini "thinks" before replying. Empty = the least each model allows (fastest).
#                           # A number = token budget (2.x models), minimal|low|medium|high = level (3.x), default = model's own
# ZEST_AI_TIMEOUT_MS=40000  # one Gemini request is abandoned (and retried / sent to the fallback model) after this long
# Questions Zest answers for signed-out visitors per UTC day, across all of them (each is a paid model call). The SOC
# gets an incident at 80%; past the limit visitors are asked to come back tomorrow or sign in. 0 turns guest Zest off.
# GUEST_ZEST_DAILY_LIMIT=500

# ── Tata Smartflo (optional — counselor call stats on Admin → Counselors → Stats) ─
# API token from the Smartflo portal; sent as-is in the Authorization header
SMARTFLO_API_TOKEN=
# SMARTFLO_API_BASE=https://api-smartflo.tatateleservices.com/v1
# SMARTFLO_UTC_OFFSET=+05:30

# 64 hex chars (openssl rand -hex 32). Encrypts SOC data at rest. Losing it makes that data unreadable.
DATA_ENCRYPTION_KEY=
# Comma-separated emails allowed to open the SOC
SOC_OWNER_EMAILS=hameed@magzest.in

# Out-of-band SOC alerts to the owner (all optional). Messages are minimal by default: severity, type, time, link.
# SOC_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...   # Slack / Teams / Discord incoming webhook (https only)
# SOC_ALERT_WEBHOOK_FORMAT=slack                               # slack | teams | discord
# SOC_TELEGRAM_BOT_TOKEN=
# SOC_TELEGRAM_CHAT_ID=
# SOC_WEBHOOK_MIN_SEVERITY=high                               # info | low | medium | high | critical
# SOC_ALERT_DETAIL=minimal                                    # "full" adds the incident title (it passes through third parties)

# ── Optional: storage and virus scanning ──
# AWS_REGION=
# AWS_S3_BUCKET=        # must be PRIVATE (Block Public Access on). Files are served only through /uploads, after the
#                       # app's access checks; stored records hold /uploads/<name>, never a bucket URL.
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# CLAMD_BIN=C:\Program Files\ClamAV\clamd.exe      # Windows: clamd binary auto-started by lib/ensureClamd.js
# CLAMD_CONFIG=C:\ClamAV-db\clamd.conf
# CLAMDSCAN_BIN=                                   # clamdscan binary used by middleware/scanUpload.js
# QUARANTINE_DIR=

# ── Optional: SOC alerting and tuning ──
# SOC_BUSINESS_HOURS_START=
# SOC_BUSINESS_HOURS_END=
# SOC_BUSINESS_TZ=
# SOC_UI_TRACK_ROLES=admin,counselor
# SOC_OWNER_RECHECK_MS=60000
# Only if data was written under an older key: comma-separated 64-hex keys the migration may read
# LEGACY_ENCRYPTION_KEYS=

# ── Optional: WhatsApp reminders (students opt in under their notification settings) ──
# Meta WhatsApp Business Cloud API. Without a template, messages only reach people who wrote to you in the last 24h,
# so for deadline and meeting reminders create an approved template whose body is a single {{1}} and name it here.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_DEFAULT_COUNTRY_CODE=91
# MEETING_TZ_OFFSET=+05:30   # zone meeting times are entered in (calendar files)
# MEETING_DAY_START_HOUR=9   # bookable hours for student call booking
# MEETING_DAY_END_HOUR=18

# ── Optional: referrals ──
# REFERRAL_REWARD_TEXT=a Rs 2,000 voucher   # shown to students on the Refer a friend card

# ── Optional: local demo data (development only; `node seed.js` refuses to run in production) ──
# One password for every seeded demo account. Unset: a random one is generated and printed once by the seed.
# SEED_DEMO_PASSWORD=
# Lets the seed run with NODE_ENV=production. It wipes every user, so set it only for a disposable environment.
# ALLOW_DEMO_SEED=true

# ── Optional: deployment ──
# Whether /uploads still accepts the old links that carried the access token (?token=). Unset: off in production, on
# elsewhere. Set to true in production only for the first day after deploying signed links, while open browser tabs
# still run the previous frontend, then remove it.
# ALLOW_LEGACY_UPLOAD_TOKENS=false
# NODE_ENV=production
# TRUST_PROXY=1
# RUN_JOBS=false          # off: this instance starts no scheduled jobs. Set on all but one instance (see docs/DEPLOYMENT.md)
# REQUEST_LOG_FLUSH_MS=2000   # how often batched request-log rows are written to Mongo; 0 = write each one at once

# ── Optional: logging and error tracking ──
# LOG_FORMAT=json        one JSON line per log call (default: json when NODE_ENV=production, text otherwise)
# LOG_LEVEL=info         debug | info | warn | error
# SENTRY_DSN=            Sentry project DSN; unset = error tracking off. Only exceptions, stacks and a few tags are sent.
# SENTRY_ENVIRONMENT=    defaults to NODE_ENV
# SENTRY_RELEASE=        e.g. the git commit, so errors group by deploy

# ── Optional: Zest tuning / evaluation ──
# ZEST_RETRY_BASE_MS=700    # base back-off between AI retries
# EVAL_DELAY_MS=            # pause between questions in scripts/zestEval.js

# ── Optional: automatic reminders ──
# DOCUMENT_REMINDERS=off   # pauses the daily "documents still needed" reminder (e.g. on a dev machine pointed at live data)
#                          # preview who would be reminded, sending nothing: node server/scripts/documentRemindersPreview.js
