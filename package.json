{
  "name": "abroad-consultancy-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "cd server && npm run dev",
    "build": "tsc && vite build",
    "postbuild": "node scripts/generate-seo.mjs && node scripts/finalize-dist.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run --config vitest.config.frontend.ts",
    "test:ui:watch": "vitest --config vitest.config.frontend.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "dompurify": "^3.4.7",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.294.0",
    "qrcode-generator": "^2.0.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.9.3",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "acorn": "^8.19.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "mongodb-memory-server": "^11.3.0",
    "postcss": "^8.4.31",
    "supertest": "^7.3.0",
    "tailwindcss": "^3.3.5",
    "terser": "^5.51.2",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
