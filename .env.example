# Copy this file to .env and fill in values before starting or building the frontend

# ── Backend URL (leave empty for local dev — defaults to http://localhost:5000) ─
VITE_API_URL=https://your-backend.onrender.com

# ── Local development only: the demo login buttons (they and this value are left out of production builds) ─
# Put it in .env.local, set to the password the seed printed or to server/.env's SEED_DEMO_PASSWORD.
# VITE_DEMO_PASSWORD=
