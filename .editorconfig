# https://editorconfig.org — most editors (VS Code needs the "EditorConfig" extension) read this, so everyone writes the
# same line endings and indentation. It is the editor-side half of .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf

[Makefile]
indent_style = tab
